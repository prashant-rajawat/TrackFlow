# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Comma-separated list of additional trusted origins for CORS (e.g. https://app.example.com)
ALLOWED_ORIGINS=

# Database Configuration
# Production strictly requires a reachable MONGODB_URI.
# Development memory mode is only enabled when ALLOW_MEMORY_DB=true and MONGODB_URI is unset.
MONGODB_URI=
ALLOW_MEMORY_DB=true
TRY_LOCAL_MONGO=true

# Development Demo Account Seeding (Strictly disabled in production)
ENABLE_DEMO_SEED=false
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Authentication & Security
# Generate a strong random secret (>= 32 chars) in production
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

# Brute-Force Rate Limiting & Lockout Policy
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Cookie Configuration (defaults to same-site Lax; Secure enforced automatically in production)
COOKIE_SAMESITE=lax
CROSS_SITE_COOKIES=false
COOKIE_DOMAIN=

# Frontend Configuration (Vite)
VITE_API_BASE_URL=
# Optional dev-only login autofill helper (never set real credentials in committed files)
VITE_ENABLE_DEMO_FILL=false
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# Attachment Storage Configuration (Phase 8)
# Production requires STORAGE_PROVIDER=s3 or supabase with real credentials; local disk is disabled in production.
# Development defaults to local disk (.trackflow-uploads) unless ALLOW_LOCAL_ATTACHMENT_STORAGE=false.
STORAGE_PROVIDER=
ALLOW_LOCAL_ATTACHMENT_STORAGE=true
LOCAL_UPLOAD_DIR=.trackflow-uploads

# AWS S3 / S3-Compatible Object Storage (when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Supabase Storage (when STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trackflow-attachments

# AI Studio injected environment variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
